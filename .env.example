# API Keys necesarias
GOOGLE_API_KEY=tu_api_key_de_google_aqui

# Clave para autenticar las peticiones al endpoint /chat (Header: X-API-KEY)
CHAT_API_KEY=tu_api_key_de_chat_aqui

# --- Resilience del free tier de Gemini ---
# El free tier responde ~15 RPM y devuelve 503 UNAVAILABLE cuando el modelo se
# satura. Estos parametros evitan que esa saturacion llegue al usuario final.

# Modelo principal (proveedor/modelo)
MODEL=google_genai/gemini-3.1-flash-lite

# Modelos de respaldo separados por coma. Se prueban en orden si el principal
# falla. Usa alias "-latest" porque Google retira los modelos concretos.
FALLBACK_MODELS=google_genai/gemini-flash-lite-latest,google_genai/gemini-3.5-flash-lite,google_genai/gemini-flash-latest

# Reintentos por llamada al modelo antes de pasar al modelo de respaldo.
# El valor por defecto de google-genai es 5 y aplica un backoff de 1+2+4+8s,
# lo que hace que un request tarde 25s antes de fallar.
LLM_MAX_RETRIES=2

# Timeout de una llamada individual al modelo, en segundos.
LLM_TIMEOUT=30

# Timeout total de un turno completo del agente, en segundos.
LLM_TOTAL_TIMEOUT=45

# Conversaciones simultaneas permitidas. Protege la cuota y la RAM de Render.
MAX_CONCURRENCY=3

# Tiempo de espera en cola antes de devolver 503 con Retry-After, en segundos.
QUEUE_TIMEOUT=60

# Horas de inactividad tras las cuales se libera la memoria de una sesion.
SESSION_TTL_SECONDS=7200

# (Opcional) Herramienta de captura de leads por email
LEAD_API_URL=URL_del_backend_que_guarda_leads
RESEND_API_KEY=tu_api_key_de_resend_aqui

# Opcionalmente, puedes agregar otras claves de API para otros proveedores o servicios que quieras usar en tu agente. Por ejemplo:
# TAVILY_API_KEY=tu_api_key_de_tavily_aqui
# LANGSMITH_PROJECT=nombre_de_tu_proyecto_en_langsmith
# LANGSMITH_API_KEY=tu_api_key_de_langsmith_aqui